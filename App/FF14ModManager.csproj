<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.22621 = Windows SDK projection for Windows.Graphics.Capture (game-window screenshots). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FF14ModManager</AssemblyName>
    <RootNamespace>FF14ModManager</RootNamespace>
    <Version>1.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF drops System.IO from implicit usings (clash with Shapes.Path); nothing here uses Shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Penumbra's mod_data.db (folder tree, favourites, local tags, notes) is a LiteDB file. -->
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

</Project>
