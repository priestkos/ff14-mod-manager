<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>FF14ModManagerBridge</AssemblyName>
    <RootNamespace>FF14ModManagerBridge</RootNamespace>

    <Author>PriestKos</Author>
    <Authors>PriestKos</Authors>
    <Name>FF14 Mod Manager Bridge</Name>
    <Punchline>Lets the FF14 Mod Manager desktop app see your character and apply designs and mods.</Punchline>
    <Description>Companion to the FF14 Mod Manager Windows app. Answers over a local, current-user-only named pipe: who you are, which Penumbra collection is on you, and applies Glamourer designs or toggles Penumbra mods on request.</Description>
    <Tags>penumbra;glamourer;mods;companion</Tags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    <PackageReference Include="Glamourer.Api" Version="2.8.2" />
  </ItemGroup>

  <!-- The pipe protocol is shared with the desktop app; it is Dalamud-free on purpose. -->
  <ItemGroup>
    <Compile Include="../App/Core/Bridge.cs" Link="Core/Bridge.cs" />
  </ItemGroup>

</Project>
